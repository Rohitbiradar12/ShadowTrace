# Copy to server/.env and adjust. All variables use the ST_ prefix.
ST_MONGO_URL=mongodb://localhost:27017
ST_MONGO_DB=shadowtrace
ST_MAX_BATCH_EVENTS=1000
ST_HEARTBEAT_INTERVAL_SECONDS=10

# Dashboard accounts are created with: python -m app.cli create-user admin --role admin
# Use HTTPS and set secure cookies to true when deploying beyond localhost.
ST_SESSION_HOURS=8
ST_SESSION_COOKIE_SECURE=false
ST_PUBLIC_URL=http://127.0.0.1:8000

# Rule and intel paths default to the repository's rules/ and intel/lists.yaml.
ST_DETECTION_ENABLED=true
ST_ALERT_DEDUP_SECONDS=600
ST_DETECTION_POLL_SECONDS=2

# Auto-response also requires response.auto_action in a rule and endpoint responses.enabled.
ST_AUTO_RESPONSE_ENABLED=false
ST_AUTO_RESPONSE_MAX_EVENT_AGE_SECONDS=60

# Enable only after configuring your own notification destinations.
ST_NOTIFICATIONS_ENABLED=false
ST_NOTIFICATIONS_PER_MINUTE=5
ST_NOTIFICATION_MAX_ATTEMPTS=5
ST_TELEGRAM_BOT_TOKEN=
ST_TELEGRAM_CHAT_ID=
# Controls require the configured chat AND a numeric operator ID from this JSON list.
# Use a dedicated bot without a webhook or another getUpdates consumer.
ST_TELEGRAM_CONTROLS_ENABLED=false
ST_TELEGRAM_ALLOWED_USER_IDS=[]
ST_TELEGRAM_BUTTON_MINUTES=60
ST_SMTP_HOST=
ST_SMTP_PORT=587
ST_SMTP_USERNAME=
ST_SMTP_PASSWORD=
ST_SMTP_FROM=
ST_SMTP_TO=
ST_SMTP_SSL=false
ST_SMTP_STARTTLS=true
